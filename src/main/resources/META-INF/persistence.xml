<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="gestao-escolar" transaction-type="RESOURCE_LOCAL">
        <class>br.dev.mpp.modelo.Curso</class>
        <class>br.dev.mpp.modelo.Estudante</class>
        <class>br.dev.mpp.modelo.Turma</class>
        <class>br.dev.mpp.modelo.Matricula</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <!-- H2 em arquivo na pasta do usuário: ~/gestao-escolar/banco.mv.db -->
            <!-- AUTO_SERVER permite abrir o banco no IntelliJ com a aplicação rodando -->
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:h2:~/gestao-escolar/banco;AUTO_SERVER=TRUE"/>
            <property name="jakarta.persistence.jdbc.user" value="sa"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>

            <!-- Cria/atualiza as tabelas a partir das entidades -->
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
